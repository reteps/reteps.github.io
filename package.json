{
  "name": "stenger.io",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build",
    "postbuild": "svelte-sitemap --domain https://stenger.io",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:tsgo": "svelte-kit sync && tsgo --noEmit -p ./tsconfig.json",
    "format:check": "oxfmt --check .",
    "lint": "eslint . && pnpm lint:workflows && pnpm lint:markdown",
    "lint:workflows": "github-actionlint",
    "lint:markdown": "markdownlint-cli2",
    "format": "oxfmt --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/mdi": "^1.2.3",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/enhanced-img": "^0.10.4",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.9.2",
    "@typescript/native-preview": "7.0.0-dev.20260605.1",
    "eslint": "^10.4.1",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-svelte": "^3.19.0",
    "github-actionlint": "^1.7.12",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "markdownlint-cli2": "^0.22.1",
    "mdast-util-to-string": "^4.0.0",
    "mdsvex": "^0.12.7",
    "oxfmt": "^0.53.0",
    "rehype-katex-svelte": "^1.2.0",
    "remark-math": "^2.0.1",
    "sass": "^1.57.1",
    "svelte": "^5.56.2",
    "svelte-check": "^4.6.0",
    "svelte-eslint-parser": "^1.8.0",
    "svelte-sitemap": "^3.2.0",
    "tailwindcss": "^4.3.0",
    "tslib": "^2.4.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "unist-util-visit": "^5.1.0",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.0.16"
  },
  "type": "module",
  "dependencies": {
    "@giscus/svelte": "^3.1.0",
    "@lucide/svelte": "^1.17.0",
    "@neodrag/svelte": "^2.3.3",
    "mdsvex-relative-images": "^2.0.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-attr": "^0.11.1",
    "remark-captions": "^2.2.2"
  }
}
