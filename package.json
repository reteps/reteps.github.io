{
  "name": "stenger.io",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build",
    "postbuild": "svelte-sitemap --domain https://stenger.io",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format:check": "oxfmt --check .",
    "lint": "eslint . && pnpm lint:workflows && pnpm lint:markdown",
    "lint:workflows": "github-actionlint",
    "lint:markdown": "markdownlint-cli2",
    "format": "oxfmt --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^1.0.0-next.50",
    "@sveltejs/kit": "^1.0.0",
    "@tailwindcss/typography": "^0.5.8",
    "@types/node": "^25.9.2",
    "autoprefixer": "^10.4.13",
    "eslint": "^10.4.1",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-svelte": "^3.19.0",
    "github-actionlint": "^1.7.12",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "markdownlint-cli2": "^0.22.1",
    "mdast-util-to-string": "^4.0.0",
    "mdsvex": "^0.10.6",
    "oxfmt": "^0.53.0",
    "postcss": "^8.4.20",
    "rehype-katex-svelte": "^1.1.2",
    "remark-math": "^2.0.1",
    "sass": "^1.57.1",
    "svelte": "^3.54.0",
    "svelte-check": "^4.6.0",
    "svelte-eslint-parser": "^1.8.0",
    "svelte-sitemap": "^2.5.4",
    "tailwindcss": "^3.2.4",
    "tslib": "^2.4.1",
    "typescript": "^4.9.3",
    "typescript-eslint": "^8.60.1",
    "unist-util-visit": "^5.1.0",
    "vite": "^4.0.0",
    "vite-imagetools": "^4.0.14",
    "vite-plugin-compression": "^0.5.1"
  },
  "type": "module",
  "dependencies": {
    "@giscus/svelte": "^2.2.6",
    "@neodrag/svelte": "^1.2.4",
    "mdsvex-relative-images": "^1.0.3",
    "rehype-autolink-headings": "^6.1.1",
    "rehype-slug": "^5.1.0",
    "remark-attr": "^0.11.1",
    "remark-captions": "^2.2.2",
    "remark-gfm": "^3.0.1",
    "svelte-feather-icons": "^4.0.0"
  }
}
