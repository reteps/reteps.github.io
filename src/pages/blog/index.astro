---
import { getCollection } from 'astro:content';
import { externalPosts } from '$lib/external-posts';
import { formatDate } from '$lib/utils';
import { inferDescription } from '$lib/utils/infer-description';
import Link from '../../components/Link.astro';
import AppLayout from '../../layouts/AppLayout.astro';

const collection = await getCollection('blog');

const localPosts = collection.map((entry) => ({
  title: entry.data.title,
  date: entry.data.date,
  description: inferDescription(entry.body ?? ''),
  path: `/blog/${entry.id}`,
  external: false
}));

const external = externalPosts.map((post) => ({
  title: post.title,
  date: post.date,
  description: post.description,
  path: post.url,
  external: true
}));

const posts = [...localPosts, ...external].sort((a, b) => {
  const [ma, da, ya] = a.date.split('-');
  const [mb, db, yb] = b.date.split('-');
  return +new Date(+yb, +mb - 1, +db) - +new Date(+ya, +ma - 1, +da);
});
---

<AppLayout title="Blog posts" description="All of my blog posts.">
  <div class="content px-10 pt-10 dark:text-white">
    <h1 class="text-4xl mb-5">Posts</h1>

    <ul>
      {
        posts.map((post) => (
          <li class="mb-3">
            <div>
              <h2 class="flex flex-row items-center">
                <Link class="text-xl" href={post.path} simple>
                  {post.title}
                </Link>
                {
                  post.external && (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="ml-2"
                    >
                      <path d="M15 3h6v6" />
                      <path d="M10 14 21 3" />
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                    </svg>
                  )
                }
              </h2>
            </div>
            <div class="lg:w-1/2">{post.description}</div>
            <div class="flex flex-row items-center">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="mr-2"
              >
                <path d="M8 2v4" />
                <path d="M16 2v4" />
                <rect width="18" height="18" x="3" y="4" rx="2" />
                <path d="M3 10h18" />
              </svg>
              {formatDate(post.date)}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</AppLayout>

<style>
  .content {
    min-height: 70vh;
  }
</style>
