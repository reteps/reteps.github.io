---
import 'katex/dist/katex.min.css';
import { getCollection, render } from 'astro:content';
import Comments from '$lib/components/Comments.svelte';
import { formatDate } from '$lib/utils';
import { inferDescription } from '$lib/utils/infer-description';
import AppLayout from '../../layouts/AppLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, date } = post.data;
const description = inferDescription(post.body ?? '');
---

<AppLayout {title} {description}>
  <article class="flex flex-col dark:text-white items-center">
    <div
      class="prose prose-sm md:prose-md lg:prose-lg pt-10 px-10 dark:prose-invert prose-a:break-words prose-code:break-words prose-img:mx-auto prose-figcaption:text-center"
    >
      <div class="not-prose">
        <h1 class="text-3xl">{title}</h1>
        <p>Published: <strong>{formatDate(date)}</strong></p>
      </div>
      <Content />
      <div class="not-prose">
        <Comments client:idle term={title} />
      </div>
    </div>
  </article>
</AppLayout>

<style>
  .prose {
    max-width: min(100vw, 65ch);
  }
</style>
