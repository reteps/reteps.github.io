---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Headshot1 from '$assets/pfp_cherry.jpg';
import HeadshotHacker from '$assets/pfp_cherry_hacker.png';
import Headshot from '$lib/components/Headshot.svelte';
import Link from '../components/Link.astro';
import AppLayout from '../layouts/AppLayout.astro';

const seo = {
  title: 'Peter Stenger',
  description:
    "Hi! I'm Peter Stenger, a computer science graduate from the University of Illinois Urbana Champaign (UIUC).",
  image: 'preview.png'
};

async function optimize(src: ImageMetadata, widths: number[], sizes: string) {
  const img = await getImage({ src, widths, sizes, format: 'webp' });
  return { src: img.src, srcset: img.srcSet.attribute };
}

const headshotSizes = '(min-width: 1024px) 30vw, 50vw';
const light = await optimize(Headshot1, [1000], headshotSizes);
const dark = await optimize(HeadshotHacker, [1000], headshotSizes);
---

<AppLayout {...seo}>
  <div id="intro" class="flex flex-col">
    <div class="flex flex-col-reverse lg:flex-row mx-10 mt-20">
      <div class="lg:w-3/4 text-black dark:text-white lg:ml-10">
        <h1 class="text-4xl font-bold text-purple-700 dark:text-green-700">Hi! I'm Peter Stenger!</h1>
        <p class="mt-5">
          I'm a software engineer at <Link hred="https://deepmind.google/" simple>Google DeepMind</Link>
          and a computer science graduate from the University of Illinois Urbana Champaign (<Link href="https://illinois.edu/" simple
            >UIUC</Link
          >). I'm passionate about open source software, automation, cybersecurity, and education.
        </p>
        <h2 class="text-xl font-bold mt-10">Previously...</h2>
        <ul class="list-disc">
          <li>A software developer at <Link href="https://www.mechanize.work/" simple>Mechanize</Link>.</li>
          <li>The founding engineer at <Link href="https://prairielearn.org/" simple>PrairieLearn</Link>.</li>
          <li>A student at UIUC doing a 3+1 MCS <Link
              href="https://cs.illinois.edu/academics/graduate/fifth-year-masters-programs/5-year-bs-ms-program"
              simple>program</Link
            >.</li>
            <li>
          A TA for <Link
              href="https://courses.grainger.illinois.edu/cs425/fa2024/"
              simple>CS 425</Link
            > and CS 128.
            </li>
          <li>
            The president of <Link href="https://sigpwny.com/" simple>SIGPwny</Link>.
          </li>
        </ul>
        <h2 class="text-xl font-bold mt-10">Questions?</h2>
          <p>Contact me at <code>peter @ stenger.io</code></p>
      </div>
      <div class="flex flex-row justify-center mb-10">
        <div class="w-1/2 lg:w-3/5">
          <Headshot client:load {light} {dark} />
        </div>
      </div>
    </div>
  </div>
</AppLayout>
